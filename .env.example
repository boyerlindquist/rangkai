# =============================================================================
# Rangkai — Environment Variables Template
# Copy this file to .env on production and fill in your real values.
# NEVER commit the actual .env file to git!
# =============================================================================

# Django Secret Key (Generate a random 50+ character string)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (MUST be False in production)
DJANGO_DEBUG=False

# Allowed Hosts (Comma-separated: your domain, www.yourdomain, and server IP)
# For VPS: 43.173.40.113,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=43.173.40.113,localhost,127.0.0.1

# CSRF Trusted Origins (Comma-separated with http:// or https://)
# For VPS: http://43.173.40.113,https://43.173.40.113
DJANGO_CSRF_TRUSTED_ORIGINS=http://43.173.40.113,https://43.173.40.113,http://localhost:8008,http://127.0.0.1:8008
