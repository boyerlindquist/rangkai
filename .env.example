# =============================================================================
# Rangkai — Environment Variables Template
# Copy this file to .env on production and fill in your real values.
# NEVER commit the actual .env file to git!
# =============================================================================

# Django Secret Key (Generate a random 50+ character string)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (MUST be False in production)
DJANGO_DEBUG=False

# Allowed Hosts (Comma-separated: your domain, www.yourdomain, and server IP)
# For VPS: 43.173.40.113,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=43.173.40.113,localhost,127.0.0.1

# CSRF Trusted Origins (Comma-separated with http:// or https://)
# For VPS: https://rangkai.click,https://www.rangkai.click,http://43.173.40.113,https://43.173.40.113
DJANGO_CSRF_TRUSTED_ORIGINS=https://rangkai.click,https://www.rangkai.click,http://43.173.40.113,https://43.173.40.113,http://localhost:8008,http://127.0.0.1:8008

# =============================================================================
# Database Configuration (PostgreSQL 16)
# If left empty, Django automatically falls back to local SQLite (db.sqlite3)
# =============================================================================
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>
# DJANGO_DB_CONN_MAX_AGE=600


# =============================================================================
# Email / SMTP Configuration (Password Reset & Transactional Emails)
# Leave EMAIL_HOST empty in local dev to print reset links directly to terminal console.
# Works with Resend, Brevo, Mailgun, Postmark, or Gmail App Password.
# =============================================================================
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxx
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Rangkai.click <noreply@rangkai.click>


# =============================================================================
# Sumopod Managed Payment Gateway (QRIS)
# Webhook URL di Dashboard Sumopod: https://rangkai.click/webhooks/sumopod/
# Kosongkan SUMOPOD_API_KEY di local dev jika ingin pakai mode simulasi.
# =============================================================================

# [WAJIB] Ambil dari Dashboard Sumopod -> Settings -> API Key
SUMOPOD_API_KEY=your_sumopod_live_api_key_here

# [WAJIB] Live URL: https://api-pay.sumopod.com/api/v1 (Sandbox: https://api-pay-sandbox.sumopod.com/api/v1)
SUMOPOD_BASE_URL=https://api-pay.sumopod.com/api/v1

# [WAJIB] Ambil dari Dashboard Sumopod -> Settings -> Webhook -> Webhook Token (muncul setelah Save Webhook URL)
SUMOPOD_WEBHOOK_TOKEN=whtok_xxxxxxxxxxxxxxxxxxxxxxxx

# [OPSIONAL] Kosongkan saja jika SUMOPOD_WEBHOOK_TOKEN di atas sudah diisi (Webhook Signing Secret: whsec_...)
SUMOPOD_WEBHOOK_SECRET=

# [OPSIONAL] Kosongkan jika project Sumopod tidak sharing webhook dengan app lain
SUMOPOD_FORWARD_WEBHOOK_URL=

# [OPSIONAL] Batas waktu kedaluwarsa tagihan QRIS (dalam jam)
SUMOPOD_EXPIRES_IN_HOURS=24

# [KHUSUS TESTING LOKAL SAJA - JANGAN DIPASANG DI PRODUCTION]
# Override nominal semua paket sementara (misal 1000 = Rp 1.000) untuk tes bayar QRIS murah:
# SUMOPOD_TEST_AMOUNT=1000
